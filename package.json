{
  "name": "lekki-geoportal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch-path=server --watch-path=src/services server/index.ts",
    "build": "tsc -b && vite build && node scripts/precompress.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "capabilities": "node --env-file-if-exists=.env server/refresh.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.1.7",
    "ol": "^10.6.1",
    "proj4": "^2.19.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
