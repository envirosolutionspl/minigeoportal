# Copy to .env and fill in. Never commit .env.

# Public address of the app, when it is not https://<domain of app.yaml>: links in bug reports may
# point only here.
# APP_ORIGIN=https://map.example.org

# Docker Compose: the domain for Caddy. Keep it here, Compose reads it on every command.
# DOMAIN=map.example.org

# production: the server also serves the built app from dist/ (the Docker image sets it).
# NODE_ENV=production

# Listening address. Behind a reverse proxy keep HOST=127.0.0.1, so nobody reaches the server
# directly with forged client headers. Default: 127.0.0.1, or 0.0.0.0 with NODE_ENV=production.
# PORT=8787
# HOST=127.0.0.1
# In development the Vite proxy reaches the API on API_PORT (default 8787).
# API_PORT=8787

# Behind a reverse proxy (nginx, Caddy, Cloudflare) that APPENDS the client address to
# X-Forwarded-For: the last entry is then taken as the client address for rate limits.
# TRUSTED_PROXY=1

# Mail to the administrator (admin in app.yaml): bug reports and critical errors of the server.
# Without SMTP_HOST or that address both are off.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# TLS from the start on port 465, STARTTLS before any login on other ports; set only to override.
# REPORT_FROM defaults to SMTP_USER; without either the form and the alert mails stay off.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# REPORT_FROM="MiniGeoportal <no-reply@example.com>"

# Where caches live (capabilities, catalog, dictionaries). Default: server/data.
# A single server refreshes them once a day itself; `npm run update` does it at once, and the
# server reads what it wrote within a minute.
# DATA_DIR=/var/lib/minigeoportal

# Several instances on one DATA_DIR: none of them builds the caches itself, all read them again
# when `npm run update` has written them (within a minute).
# SHARED_DATA=1

# The deployment's configuration (app.yaml, map.yaml, layers.yaml); ./config by default.
# CONFIG_DIR=/etc/minigeoportal
