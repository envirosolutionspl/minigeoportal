# Copy to .env and fill in. Never commit .env.

# Public address of the app; links in bug reports must point here.
APP_ORIGIN=https://prostygeoportal.pl

# Bug report form: mail server and recipient. Without SMTP_HOST and REPORT_TO the form is off.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (TLS from the start); otherwise STARTTLS is used when the server offers it.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
REPORT_FROM="Prosty Geoportal <no-reply@example.com>"
REPORT_TO=admin@example.com

# Behind a reverse proxy that sets X-Forwarded-For.
# TRUSTED_PROXY=1
